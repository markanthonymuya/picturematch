<Window x:Class="PictureMatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PictureMatch" Height="760" Width="1120" MinHeight="620" MinWidth="900"
        Background="#F4F5FA" WindowStartupLocation="CenterScreen" WindowState="Maximized"
        AllowDrop="True" Drop="Window_Drop" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="28,20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#221B46" Offset="0"/>
                    <GradientStop Color="#45358D" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="PictureMatch" Foreground="White" FontSize="25" FontWeight="Bold"/>
                    <TextBlock Text="Private, local visual search for your photo library" Foreground="#D8D3F5" FontSize="13" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="About matching" Click="About_Click"
                            Background="#39305D" Foreground="White"/>
                    <Button x:Name="TopSearchButton" Content="🔎  SEARCH NOW" Click="Search_Click"
                            Background="#8B73FF" Foreground="White" FontSize="15" Padding="22,12"
                            Margin="10,0,0,0" ToolTip="Search the selected folders for matching pictures"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#ECE9FF" CornerRadius="10" Padding="7,2" Margin="0,0,8,0">
                                <TextBlock Text="1" Foreground="{StaticResource Accent}" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="Search folders" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="All subfolders are included." Foreground="{StaticResource Muted}" Margin="0,3,0,12"/>
                        <ListBox x:Name="FoldersList" Height="128" BorderBrush="#E4E7EC" BorderThickness="1"
                                 SelectionMode="Extended" DisplayMemberPath="Path"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="+ Add folder" Click="AddFolder_Click"/>
                            <Button Grid.Column="2" Content="Remove" Click="RemoveFolder_Click" Background="#F2F4F7" Foreground="#475467"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#ECE9FF" CornerRadius="10" Padding="7,2" Margin="0,0,8,0">
                                <TextBlock Text="2" Foreground="{StaticResource Accent}" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="Screenshot or photo" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Select a file, paste, or drop an image here." Foreground="{StaticResource Muted}" Margin="0,3,0,12"/>
                        <Border Height="150" BorderBrush="#C9C3F6" BorderThickness="1" CornerRadius="8" Background="#F9F8FF">
                            <Grid>
                                <Image x:Name="QueryPreview" Stretch="Uniform" Margin="8"/>
                                <TextBlock x:Name="PreviewHint" Text="No screenshot selected" Foreground="#827AAE"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Button Content="Select screenshot or photo…" Click="BrowseImage_Click"
                                Background="{StaticResource Accent}" Foreground="White" Margin="0,10,0,0"
                                ToolTip="Open a Windows file-selection window"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Paste (Ctrl+V)" Click="Paste_Click"/>
                            <Button Grid.Column="2" Content="Clear" Click="ClearImage_Click" Background="#F2F4F7" Foreground="#475467"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Minimum match" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ThresholdLabel" DockPanel.Dock="Right" Text="70%" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                        </DockPanel>
                        <Slider x:Name="ThresholdSlider" Minimum="40" Maximum="98" Value="70" TickFrequency="1"
                                ValueChanged="ThresholdSlider_ValueChanged" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Button x:Name="SearchButton" Content="🔎  SEARCH NOW" Click="Search_Click"
                        Background="{StaticResource Accent}" Foreground="White" FontSize="15" Padding="18,13" Margin="0,16,0,0"/>
            </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Top 5 matches" FontSize="20" FontWeight="Bold"/>
                            <TextBlock x:Name="ResultSummary" Text="Your five closest matches will appear here." Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Click="Cancel_Click"
                                Visibility="Collapsed" Background="#FEE4E2" Foreground="#B42318"/>
                    </DockPanel>
                    <ProgressBar x:Name="SearchProgress" Grid.Row="1" Height="5" Margin="0,15,0,10"
                                 Foreground="{StaticResource Accent}" Background="#ECE9FF" Visibility="Collapsed"/>
                    <ListView x:Name="ResultsList" Grid.Row="2" BorderThickness="0" Margin="0,4,0,0"
                              MouseDoubleClick="ResultsList_MouseDoubleClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EAECF0" BorderThickness="0,0,0,1" Padding="4,13">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88"/>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="76" Height="60" CornerRadius="6" Background="#F2F4F7">
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ScoreText}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                            <TextBlock Text="similar" Foreground="{StaticResource Muted}" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,14,0">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Directory}" Foreground="{StaticResource Muted}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Open image" Tag="{Binding FullPath}" Click="OpenImage_Click" Margin="0,0,7,0"/>
                                            <Button Content="Show folder" Tag="{Binding FullPath}" Click="ShowFolder_Click"
                                                    Background="#F2F4F7" Foreground="#344054"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#EAECF0" Padding="24,8">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="#475467" FontSize="12"/>
        </Border>
    </Grid>
</Window>
